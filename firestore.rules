rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Napredak svakog korisnika: samo on čita i piše.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Rang lista ukupno: svi prijavljeni čitaju, svako piše samo svoj red.
    match /lbAll/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp < 10000000
        && request.resource.data.name is string && request.resource.data.name.size() <= 24;
    }
    // Rang lista po nedeljama.
    match /lb/{week}/users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp < 1000000
        && request.resource.data.name is string && request.resource.data.name.size() <= 24;
    }
  }
}
